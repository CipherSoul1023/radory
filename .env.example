# Application
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001
FRONTEND_PORT=5173
BACKEND_PORT=8001

# Managed Neon PostgreSQL (normal development)
DATABASE_URL=

# Optional local PostgreSQL fallback (--profile local-infra)
POSTGRES_USER=radory
POSTGRES_DB=radory
POSTGRES_PASSWORD=
LOCAL_POSTGRES_PORT=5434

# Managed Upstash Redis (normal development; use a rediss:// URL)
REDIS_URL=

# Optional local Redis fallback (--profile local-infra)
LOCAL_REDIS_PORT=6380

# Tavily
TAVILY_API_KEY=

# Nebius / NVIDIA Nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Preferred model-tier configuration
NEMOTRON_NANO_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_ULTRA_MODEL=
# Temporary backwards-compatible default model
NEMOTRON_MODEL=

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Backend Sentry (FastAPI and Celery only)
SENTRY_DSN=
