{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radory Nemotron extraction gold answer v1",
  "description": "Working human labels for the disposable Nemotron extraction experiment.",
  "$comment": "A later script must check that evidence_ids exist and that quotes occur in the prepared input blocks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "variant",
    "input_fingerprint",
    "outcome",
    "outcome_reason",
    "evidence",
    "events",
    "challenge_tags",
    "review_status"
  ],
  "properties": {
    "case_id": { "$ref": "#/$defs/non_blank" },
    "variant": { "enum": ["snippet", "raw_content"] },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": { "enum": ["assessed", "insufficient_evidence"] },
    "outcome_reason": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_blank" }]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/evidence_quote" }
    },
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/event" }
    },
    "challenge_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_blank" }
    },
    "review_status": { "$ref": "#/$defs/non_blank" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "assessed" } } },
      "then": { "properties": { "outcome_reason": { "type": "null" } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "insufficient_evidence" } } },
      "then": {
        "properties": {
          "outcome_reason": { "$ref": "#/$defs/non_blank" },
          "events": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "non_blank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "quote"],
      "properties": {
        "block_id": { "$ref": "#/$defs/non_blank" },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/non_blank" }
    },
    "supported_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_ids"],
      "properties": {
        "value": { "$ref": "#/$defs/non_blank" },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "evidence_ids"],
      "properties": {
        "key": {
          "enum": [
            "market_entry",
            "local_headcount_growth",
            "business_expansion",
            "rto_change",
            "office_opening",
            "office_relocation",
            "leadership_buildout",
            "workplace_hiring",
            "funding_expansion",
            "ma_consolidation",
            "downsizing_layoffs",
            "sublease_disposal",
            "business_rescue_closure",
            "fitout_activity",
            "named_tenant",
            "signed_lease",
            "completed_move"
          ]
        },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_ids"],
      "properties": {
        "value": {
          "enum": ["planned", "underway", "completed", "cancelled", "unclear"]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/non_blank" }
        }
      },
      "if": { "properties": { "value": { "not": { "const": "unclear" } } } },
      "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "country", "market", "submarket", "evidence_ids"],
      "properties": {
        "role": {
          "enum": ["event_location", "origin", "destination", "unclear"]
        },
        "country": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_blank" }]
        },
        "market": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_blank" }]
        },
        "submarket": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/non_blank" }]
        },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      },
      "anyOf": [
        { "properties": { "country": { "type": "string" } } },
        { "properties": { "market": { "type": "string" } } },
        { "properties": { "submarket": { "type": "string" } } }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "precision", "evidence_ids"],
      "properties": {
        "expression": { "$ref": "#/$defs/non_blank" },
        "precision": {
          "enum": ["day", "month", "quarter", "year", "range", "relative", "unclear"]
        },
        "evidence_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "related_company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "role"],
      "properties": {
        "company": { "$ref": "#/$defs/supported_value" },
        "role": { "$ref": "#/$defs/supported_value" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "subject_company",
        "summary",
        "signals",
        "stage",
        "locations",
        "timing",
        "related_companies",
        "missing_facts"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/non_blank" },
        "subject_company": { "$ref": "#/$defs/supported_value" },
        "summary": { "$ref": "#/$defs/non_blank" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/signal" }
        },
        "stage": { "$ref": "#/$defs/stage" },
        "locations": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/location" }
        },
        "timing": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/timing" }
        },
        "related_companies": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/related_company" }
        },
        "missing_facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "company_identity",
              "event_location",
              "event_timing",
              "event_stage",
              "local_headcount",
              "workplace_plans"
            ]
          }
        }
      }
    }
  }
}
